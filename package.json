{
  "name": "gaze-web",
  "version": "1.0.0",
  "description": "Eye Gaze Mouse Control",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "cross-env NODE_OPTIONS=--no-experimental-webstorage turbo run dev",
    "lint": "turbo run lint",
    "test": "pnpm --filter api test && cargo test",
    "build:wasm": "cargo build --target wasm32-unknown-unknown --release && cp target/wasm32-unknown-unknown/release/gaze_core.wasm apps/web/public/wasm/gaze_core.wasm",
    "test:eval": "python3 evaluation/benchmark_suite.py",
    "docker:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "turbo": "2.9.6"
  },
  "packageManager": "pnpm@10.18.2"
}
